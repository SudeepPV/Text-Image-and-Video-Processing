   "source": [
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "# =====================================================\n",
    "# CREATE XML DATA\n",
    "# =====================================================\n",
    "\n",
    "# Create the root element\n",
    "root = ET.Element(\"students\")\n",
    "\n",
    "# Create first student\n",
    "student1 = ET.SubElement(root, \"student\", id=\"101\")\n",
    "\n",
    "ET.SubElement(student1, \"name\").text = \"Alice\"\n",
    "ET.SubElement(student1, \"age\").text = \"21\"\n",
    "ET.SubElement(student1, \"department\").text = \"Computer Science\"\n",
    "ET.SubElement(student1, \"cgpa\").text = \"8.75\"\n",
    "\n",
    "# Create second student\n",
    "student2 = ET.SubElement(root, \"student\", id=\"102\")\n",
    "\n",
    "ET.SubElement(student2, \"name\").text = \"Bob\"\n",
    "ET.SubElement(student2, \"age\").text = \"22\"\n",
    "ET.SubElement(student2, \"department\").text = \"Electronics\"\n",
    "ET.SubElement(student2, \"cgpa\").text = \"9.10\"\n",
    "\n",
    "# =====================================================\n",
    "# SAVE XML TO FILE\n",
    "# =====================================================\n",
    "\n",
    "tree = ET.ElementTree(root)\n",
    "\n",
    "tree.write(\n",
    "    \"students.xml\",\n",
    "    encoding=\"utf-8\",\n",
    "    xml_declaration=True\n",
    ")\n",
    "\n",
    "print(\"XML file created successfully.\")"
   ]
  },
